# ─── Application ─────────────────────────────────────────────────────────────
PROJECT_NAME="RenewGrid"

# ─── Database ─────────────────────────────────────────────────────────────────
# Connection string for your PostgreSQL instance
# e.g., postgresql://username:password@localhost:5432/renewgrid
DATABASE_URL="postgresql://username:password@localhost:5432/renewgrid"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate secure keys using: openssl rand -hex 32
SECRET_KEY="your-super-secret-access-key-here"
REFRESH_SECRET_KEY="your-super-secret-refresh-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
# Configure your SMTP settings here (e.g., Gmail App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password-without-spaces

# ─── Frontend ──────────────────────────────────────────────────────────────────
# Base URL for building email reset/verification links
FRONTEND_URL=http://localhost:5173

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to perform CORS requests
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
