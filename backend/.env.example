# ─── Application ─────────────────────────────────────────────────────────────
PROJECT_NAME="RenewGrid"

# Application environment: development | test | production
APP_ENV=development

# ─── Database ─────────────────────────────────────────────────────────────────
# Connection string for your PostgreSQL instance
# e.g., postgresql://username:password@localhost:5432/renewgrid
DATABASE_URL="postgresql://username:password@localhost:5432/renewgrid"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate secure keys using: openssl rand -hex 32
SECRET_KEY="your-super-secret-access-key-here"
REFRESH_SECRET_KEY="your-super-secret-refresh-key-here"
JWT_ALGORITHM="HS256"

# Keep access tokens short-lived.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# HttpOnly refresh session lifetime.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Session cookies ──────────────────────────────────────────────────────────
# False only for local HTTP development.
# Must be true for production HTTPS.
COOKIE_SECURE=false

# ─── Email / SMTP ──────────────────────────────────────────────────────────────
# Configure your SMTP settings here (e.g., Gmail App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-smtp-app-password-without-spaces

# ─── Frontend ──────────────────────────────────────────────────────────────────
# Base URL for building email reset/verification links
FRONTEND_URL=http://localhost:5173

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to perform CORS requests
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Demo seeding (Fix 10) ─────────────────────────────────────────────────────
# Demo seeding is disabled by default.
# Set ENABLE_DEMO_SEED=true only when intentionally seeding
# an isolated development database.
ENABLE_DEMO_SEED=false

# Optional local-only demo accounts.
# Configure these in your uncommitted local .env — never commit real passwords.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

DEMO_COLLECTOR_EMAIL=
DEMO_COLLECTOR_PASSWORD=

DEMO_RECYCLER_EMAIL=
DEMO_RECYCLER_PASSWORD=
